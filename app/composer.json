{
    "name": "zwischenfunk/redeemer2",
    "description": "Redeemer Wien: Verwaltung von Mitgliedern, Knoten und Geräten bei FunkFeuer Wien",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-ldap": "*",
        "ext-pdo_pgsql": "*",
        "doctrine/dbal": "^4.2",
        "symfony/asset": "7.4.*",
        "symfony/console": "7.4.*",
        "symfony/form": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/ldap": "7.4.*",
        "symfony/mailer": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/security-bundle": "7.4.*",
        "symfony/security-csrf": "7.4.*",
        "symfony/twig-bundle": "7.4.*",
        "symfony/validator": "7.4.*",
        "symfony/yaml": "7.4.*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "symfony/http-client": "7.4.*"
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "optimize-autoloader": true,
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "extra": {
        "runtime": {
            "disable_dotenv": true,
            "default_environment": "prod"
        }
    }
}
